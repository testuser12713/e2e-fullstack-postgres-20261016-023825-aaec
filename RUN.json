{
  "runcontract": 1,
  "services": [
    {
      "name": "web",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [["npm", "ci"]],
      "build": [["npm", "run", "build"]],
      "test": [["npm", "test"]],
      "start": [
        "npm",
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "${PORT}"
      ],
      "port": 5173,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [200]
      },
      "env": {
        "VITE_API_BASE_URL": {
          "dev": "${service:api.origin}"
        }
      }
    }
  ]
}
